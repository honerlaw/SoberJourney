{
  "name": "@onerlaw/soberjourney-app",
  "main": "expo-router/entry",
  "version": "1.2.0",
  "scripts": {
    "clean": "rm -rf node_modules .vscode package-lock.json ios android .expo-env.d.ts .tamagui .expo dist expo-env.d.ts tamagui-web.css",
    "clean:dist": "rm -rf .expo .tamagui tamagui-web.css ios android .expo-env.d.ts dist $TMPDIR/react-*",
    "clean:cache": "npm run clean:dist && watchman watch-del-all",
    "build": "tsc --noEmit",
    "start": "expo start",
    "android": "expo run:android",
    "android:localhost": "adb reverse tcp:3000 tcp:3000",
    "ios": "expo run:ios",
    "ios:clean": "npm run clean:cache && npm run ios --clear",
    "web": "expo start --web --clear",
    "web:export": "npm run clean:dist && expo export --clear -p web",
    "lint": "expo lint",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint:format": "expo lint --fix && npm run format",
    "test": "echo \"Error: no test specified\"",
    "eas:submit": "eas build --non-interactive --auto-submit --platform ios --no-wait",
    "eas:submit:dev": "eas build --non-interactive --auto-submit --platform ios --no-wait --profile development",
    "doctor": "npx -y expo-doctor",
    "doctor:fix": "npx expo install --check",
    "knip": "knip",
    "check:native-modules": "node scripts/check-native-module-versions.mjs"
  },
  "dependencies": {
    "@azure/core-asynciterator-polyfill": "^1.0.2",
    "@clerk/clerk-expo": "^2.20.1",
    "@expo/config-plugins": "~57.0.10",
    "@expo/metro-runtime": "~57.0.16",
    "@lottiefiles/dotlottie-react": "^0.13.5",
    "@react-native-community/datetimepicker": "9.1.0",
    "@sentry/react-native": "~7.11.0",
    "@tamagui/babel-plugin": "^1.138.2",
    "@tamagui/config": "^1.138.2",
    "@tamagui/lucide-icons": "^1.138.2",
    "@tamagui/metro-plugin": "^1.138.2",
    "@tamagui/toast": "^1.138.2",
    "@trpc/client": "^11.7.1",
    "@trpc/tanstack-react-query": "^11.7.1",
    "boring-avatars": "^2.0.4",
    "burnt": "^0.13.0",
    "expo": "~57.0.27",
    "expo-apple-authentication": "~57.0.2",
    "expo-auth-session": "~57.0.14",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.12",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.22",
    "expo-router": "57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-speech": "~57.0.3",
    "expo-speech-recognition": "^3.0.1",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "lottie-react-native": "~7.3.8",
    "markdown-it": "^14.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-reanimated": "4.5.1",
    "react-native-render-html": "^6.3.4",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "superjson": "^2.2.6",
    "tamagui": "^1.138.2",
    "web-streams-polyfill": "^4.2.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.10.4",
    "@types/react": "~19.2.4",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "knip": "^5.77.1",
    "prettier": "^3.6.2",
    "react-native-svg-transformer": "^1.5.2",
    "typescript": "~6.0.3"
  },
  "private": true,
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
